{
  "compilerOptions": {
    "lib": ["ES2020"],
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "commonjs",
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "target": "ES2021",
    "strictPropertyInitialization": false,
    "moduleResolution": "node"
  },
}